{
  "name": "life-os",
  "version": "1.0.0",
  "description": "Life OS — Academic command center for a G11 STEM boarding student",
  "author": "Life OS",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k \"vite --port 5173\" \"tsc -p tsconfig.main.json && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run && node tests/db-integration.js",
    "test:watch": "vitest",
    "test:ui": "node tests/electron-ui.mjs",
    "test:packaged": "node tests/packaged-smoke.mjs",
    "test:persist": "node tests/persistence-probe.mjs",
    "test:probe": "node tests/probe-new-ui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  },
  "build": {
    "appId": "com.lifeos.student",
    "productName": "Life OS",
    "copyright": "Copyright © 2026 Life OS",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Life OS"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@13.0.3": true
  }
}
